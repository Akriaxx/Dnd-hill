# Copie ce fichier en .env et remplis les valeurs réelles (jamais commit).

# ── Supabase ───────────────────────────────────────────────────────
# Project Settings > API sur supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project Settings > Database > Connection string > URI
DATABASE_URL=

# ── EmailJS ──────────────────────────────────────────────────────
# Crée un compte sur https://emailjs.com (gratuit, 200 mails/mois)
# 1. Ajoute un service Gmail → copie le Service ID
# 2. Crée un template avec : Subject = {{subject}}, Body (HTML) = {{{html_content}}}, To = {{to_email}}
# 3. Récupère ta Public Key dans Account > API Keys
VITE_APP_URL=http://localhost:5173
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
